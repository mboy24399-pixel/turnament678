# Firebase Web App configuration used by /api/firebase-config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backward-compatible aliases currently accepted by the API endpoint:
# NEXT_PUBLIC_FIREBASE_H_DOMAIN
# NEXT_PUBLIC_FIREBASE_BASE_URL
# NEXT_PUBLIC_FIREBASE_BUCKET
# NEXT_PUBLIC_FIREBASE_SENDER_ID

# NEXT_PUBLIC_FIREBASE_OBJECT_ID is not used as Firebase appId.
# Do not add it unless another part of the app explicitly needs it.
