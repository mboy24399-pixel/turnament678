# ─────────────────────────────────────────────
# Podmen X Tournament Arena — ENV example
# Copy to .env.local for `vercel dev`, and set the
# SAME keys in Vercel Dashboard → Settings → Environment Variables.
# ─────────────────────────────────────────────

# ── 1) Public Firebase Web configuration (REQUIRED, safe for browser) ──
# Firebase Console → Project Settings → General → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── 2) Server-only Firebase Admin SDK credentials (REQUIRED, NEVER in browser) ──
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Paste values below. Keep the quotes. \n newlines are supported.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Must match NEXT_PUBLIC_FIREBASE_DATABASE_URL (server needs explicit DB URL):
FIREBASE_DATABASE_URL=

# ── 3) Bootstrap admin(s) (recommended for first login) ──
# Comma-separated Firebase Auth UIDs that are treated as admin even before
# /admins/{uid} exists in the database. After first login, use Admin panel
# → Users → "Make admin" which writes /admins/{uid}=true.
ADMIN_UIDS=

# ── 4) Optional hardening ──
# Set to "true" to require an App Check / reCAPTCHA Enterprise token header
# (x-firebase-appcheck) on /api/command. Frontend must then send it.
APP_CHECK_ENFORCE=false
# Your reCAPTCHA Enterprise site key (only needed if you wire App Check in frontend)
RECAPTCHA_ENTERPRISE_KEY=
# Comma-separated allowed origins for /api/* (default: same-origin + vercel preview allowed)
ALLOWED_ORIGINS=
