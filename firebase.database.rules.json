{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      ".read": true,
      ".indexOn": ["status", "startAt", "registrationDeadline", "game"]
    },
    "tournamentParticipants": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "tournamentSeats": { ".read": false },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": { ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true)" }
    },
    "accounts": { "$uid": { ".read": "auth != null && $uid === auth.uid" } },
    "wallet": { "$uid": { ".read": "auth != null && $uid === auth.uid" } },
    "matches": {
      ".read": "auth != null",
      ".indexOn": ["tournamentId", "status", "updatedAt"]
    },
    "matchesByUser": { "$uid": { ".read": "auth != null && $uid === auth.uid" } },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["points"]
    },
    "tasks": {
      ".read": true,
      ".indexOn": ["active", "createdAt"]
    },
    "notifications": {
      ".read": true,
      ".indexOn": ["createdAt", "active"]
    },
    "announcements": {
      ".read": true,
      ".indexOn": ["createdAt", "active"]
    },
    "adConfig": { ".read": true },
    "admins": { ".read": false, ".write": false },
    "operations": { ".read": false, ".write": false },
    "audit": { ".read": false, ".write": false }
  }
}
