{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      ".read": "auth != null",
      "$tid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "registrations": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['userId','displayName']) && newData.child('userId').val() === $uid"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "matches": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "matchesByUser": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "wallet": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
