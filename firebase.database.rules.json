{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      ".read": "auth != null",
      ".indexOn": ["status", "startAt", "registrationDeadline", "game"]
    },
    "tournamentParticipants": {
      ".read": "auth != null",
      ".indexOn": ["status", "joinedAt"]
    },
    "tournamentSeats": {
      ".read": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid"
      }
    },
    "accounts": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid"
      }
    },
    "wallet": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid"
      }
    },
    "matches": {
      ".read": "auth != null",
      ".indexOn": ["tournamentId", "status", "updatedAt"]
    },
    "matchesByUser": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid"
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      ".indexOn": ["points"]
    },
    "tasks": {
      ".read": "auth != null",
      ".indexOn": ["active", "createdAt"]
    },
    "notifications": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "active"]
    },
    "announcements": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "active"]
    },
    "adConfig": {
      ".read": "auth != null"
    },
    "admins": {
      ".read": false,
      ".write": false
    },
    "operations": {
      ".read": false,
      ".write": false
    },
    "audit": {
      ".read": false,
      ".write": false
    }
  }
}
