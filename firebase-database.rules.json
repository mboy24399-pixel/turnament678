{
  "rules": {
    ".read": false,
    ".write": false,

    "tournaments": {
      ".read": true,
      ".write": false,
      "$tid": {
        ".read": true,
        ".write": false
      }
    },

    "tournamentPlayers": {
      ".read": "auth != null",
      ".write": false,
      "$tid": {
        ".read": "auth != null",
        ".write": false,
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".write": false
        }
      }
    },

    "matches": {
      ".read": "auth != null",
      ".write": false,
      "$mid": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "tasks": {
      ".read": true,
      ".write": false,
      "$taskId": {
        ".read": true,
        ".write": false
      }
    },

    "taskClaims": {
      ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false,
        "$taskId": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".write": false
        }
      }
    },

    "users": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },

    "walletLedger": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },

    "announcements": {
      ".read": true,
      ".write": false
    },

    "notifications": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },

    "notificationsGlobal": {
      ".read": "auth != null",
      ".write": false
    },

    "ads": {
      ".read": true,
      ".write": false
    },

    "results": {
      ".read": true,
      ".write": false
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },

    "meta": {
      ".read": true,
      ".write": false
    }
  }
}
